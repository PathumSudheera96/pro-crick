# Pro-Crick local development placeholders.
# Copy this file to .env before running Docker Compose.
# Do not set NODE_ENV here. Next.js sets it for dev/build/start commands.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

POSTGRES_USER=procric
POSTGRES_PASSWORD=procric_dev_password
POSTGRES_DB=procric

DATABASE_URI=postgresql://procric:procric_dev_password@db:5432/procric
PAYLOAD_SECRET=replace-with-a-long-random-local-secret

# Persistent local upload storage. Production/cPanel should point this at the
# persistent uploads directory configured for the Node.js app.
UPLOAD_DIR=storage
